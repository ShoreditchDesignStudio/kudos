# Copy to .env.local for development. All values are server-only — there are
# no NEXT_PUBLIC_* variables in v2 (the browser never talks to Supabase or
# Slack directly).

# Neon Postgres (no auth, no RLS, no storage in v2).
# Use the POOLED connection string (host contains "-pooler"), which is what
# Neon's HTTP driver expects. Includes the role password — treat as a secret.
# postgresql://<user>:<password>@ep-xxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=""   # quote it: the "&" before channel_binding breaks shell sourcing

# Slack app — see docs/master-architecture.md §7 for the required scopes
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_REMINDER_CHANNEL_ID=

# App
APP_BASE_URL=http://localhost:3000

# Vercel Cron auth — generate with: openssl rand -hex 32
CRON_SECRET=
